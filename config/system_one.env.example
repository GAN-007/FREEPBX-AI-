# Laya/Jev-compatible System-One decision plane for FREEPBX AI.
#
# off      - no System-One calls
# shadow   - classify/log transcripts; existing LLM/tool flow is unchanged
# advisory - also attach typed decisions to the LLM turn context
#
# The decision plane never transfers, hangs up, sends email, or executes another
# telephony tool. Existing tool authorization remains authoritative.
FREEPBX_SYSTEM_ONE_MODE=off
FREEPBX_SYSTEM_ONE_BASE_URL=http://127.0.0.1:8000
FREEPBX_SYSTEM_ONE_API_KEY=
FREEPBX_SYSTEM_ONE_TIMEOUT_SECONDS=1.0
